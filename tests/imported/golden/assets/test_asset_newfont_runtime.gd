extends AssetTest
## NewfontFont, built from the imported retail texture 310, is the font
## tools/make_font_newfont.py writes (newfont.fnt and its page newfont.png,
## generated by tools/run_tests into the folder
## [constant AssetTest.GENERATED_VARIABLE] names) as Godot's BMFont loader
## reads it with the project's import options: every stored property, glyph
## and metric is equal and the page matches pixel for pixel.

const FOLDER: String = "newfont"
const PAGE_PROPERTY: String = "/textures/0/image"


func _built() -> FontFile:
	var image: Image = catalog().base_image(NewfontPage.TEXTURE_ID)
	assert_not_null(image, "the imported assets hold texture 310")
	return NewfontFont.build(NewfontPage.build(image))


func _generated() -> FontFile:
	var folder: String = generated_folder(FOLDER)
	if folder.is_empty():
		return null
	var font := FontFile.new()
	font.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	font.generate_mipmaps = false
	font.multichannel_signed_distance_field = false
	font.hinting = TextServer.HINTING_NONE
	font.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	var error: Error = font.load_bitmap_font(folder.path_join("newfont.fnt"))
	assert_eq(error, OK, "the generator's newfont.fnt loads")
	if error != OK:
		return null
	font.allow_system_fallback = false
	font.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_ENABLED
	return font


func _stored(font: FontFile) -> Dictionary[String, Variant]:
	var values: Dictionary[String, Variant] = {}
	for property: Dictionary in font.get_property_list():
		var usage: int = property["usage"]
		var name: String = property["name"]
		if usage & PROPERTY_USAGE_STORAGE == 0 or name.ends_with(PAGE_PROPERTY) or name.begins_with("resource_"):
			continue
		values[name] = font.get(name)
	return values


func test_the_built_font_stores_what_the_generated_font_stores() -> void:
	var generated: FontFile = _generated()
	var built: FontFile = _built()
	assert_not_null(built)
	if built == null or generated == null:
		return
	var expected: Dictionary[String, Variant] = _stored(generated)
	var actual: Dictionary[String, Variant] = _stored(built)
	assert_eq(actual.keys().size(), expected.keys().size(), "the same stored properties")
	var differing := PackedStringArray()
	for name: String in expected:
		if not actual.has(name) or str(actual[name]) != str(expected[name]):
			differing.append("%s: %s, generated %s" % [name, str(actual.get(name, "<missing>")), str(expected[name])])
	assert_eq(differing, PackedStringArray(), "\n".join(differing))


func test_the_built_page_is_the_generated_page() -> void:
	var folder: String = generated_folder(FOLDER)
	var built: FontFile = _built()
	assert_not_null(built)
	if built == null or folder.is_empty():
		return
	var expected: Image = Image.load_from_file(folder.path_join("newfont.png"))
	assert_not_null(expected, "the generator's newfont.png loads")
	if expected == null:
		return
	var actual: Image = built.get_texture_image(0, NewfontPage.CACHE_SIZE, 0)
	expected.convert(Image.FORMAT_RGBA8)
	actual.convert(Image.FORMAT_RGBA8)
	assert_eq(actual.get_size(), expected.get_size())
	assert_true(actual.get_data() == expected.get_data(), "the page matches pixel for pixel")


func test_text_measures_the_same() -> void:
	var generated: FontFile = _generated()
	var built: FontFile = _built()
	if built == null or generated == null:
		return
	for text: String in ["SCORE 012345", "Hi-Score!", "~{|}"]:
		assert_eq(built.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, NewfontText.DRAW_SIZE),
			generated.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, NewfontText.DRAW_SIZE), text)
