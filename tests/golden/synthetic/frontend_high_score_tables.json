{
 "constants": {
  "main_rows": 10,
  "levels": 60,
  "level_ranks": 3,
  "checkpoints": 5,
  "run_players": 4,
  "run_marker": "Z",
  "reset_initials": "AAA",
  "ticks_per_second": 30,
  "seconds_limit_ticks": 2971,
  "seconds_limit": 99,
  "level_jungle1": 18,
  "level_jungle2": 19,
  "score_digits": 8,
  "blanked_digits": 7,
  "minutes_limit": 99,
  "seconds_at_limit": 59,
  "level_row_index": "level * 3 + rank",
  "run_time_index": "level * 5 + checkpoint"
 },
 "rules": {
  "qualify_main": "a score qualifies when some main row score < score (hsinput.c:633-641)",
  "qualify_arcade": "a level recorded this run qualifies when some row of its table, JUNGLE2 read as JUNGLE1, has score < the recorded level score (hsinput.c:690-708, 1085-1110)",
  "startup": "a pause-menu quit requests MAIN_OPTIONS before any check (hsinput.c:189-193); no qualifier requests MAIN_OPTIONS (hsinput.c:222-226); otherwise the new-score flags are cleared (hsinput.c:384-390) and the entry opens",
  "enter_main": "the first row with score < score takes the entry; rows from there move down one with initials and score only, the last row dropping (hsinput.c:799-842)",
  "enter_levels": "every recorded level in level order is entered into its table, JUNGLE2 into JUNGLE1; rows move down one with initials, score and times; the new row takes the entered initials and the run score and times of the table level (hsinput.c:871-955, 1186-1214)",
  "record": "at level completion the first record this run marks the level and stores score and checkpoint seconds; a later one replaces both only for a higher score; the level score is fr_score - fr_prev_score (gamesys.C:2733-2766)",
  "statue": "the jungle statue on JUNGLE2 records into JUNGLE1 with zero times by the same rule (gamesys.C:3493-3513)",
  "reset": "HighScoreInitialiseData resets every run row to AAA, 0, zero times when a game starts (hsinput.c:129-156, tempopt.c:1801)",
  "seconds": "the checkpoint timer, in 30 Hz ticks counting up from 0, is rounded up to a multiple of 30; 2971 and above give 99, otherwise value / 30 (FROG.C:2833-2842)",
  "line": "columns 3-23 are blanked; rank digit and dot, initials verbatim, the eight-digit score at 9-16 with up to seven leading zeros blanked, MM:SSs at 18-23 from the checkpoint-time sum, minutes above 99 shown as 99:59 (HSView.c:1690-1757)"
 },
