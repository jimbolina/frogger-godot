config_version=5

[application]

config/name="Frogger"
config/description="A Godot rewrite of Frogger (1997, PC). Needs the player's own retail game files."
run/main_scene="res://scenes/setup.tscn"
config/features=PackedStringArray("4.5")

[autoload]

GraphicsDebug="*res://src/presentation/debug/graphics_panel.gd"

[debug]

gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_local_constant=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[frogger]

rendering/effect_shadows="off"
rendering/shadows="on"

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": false,
"process/premult_alpha": false,
"process/size_limit": 0
}
wav={
"compress/mode": 0,
"edit/loop_mode": 0,
"edit/normalize": false,
"edit/trim": false,
"force/8_bit": false,
"force/max_rate": false,
"force/mono": false
}
oggvorbisstr={
"loop": false
}
font_data_bmfont={
"compress": true,
"fallbacks": [],
"scaling_mode": 2
}

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=3
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/lossless_compression/force_png=true

[shader_globals]

frogger_model_ambient={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
